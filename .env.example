# ==============================================================================
# Invoicer AI – Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-key-for-invoicer-ai-development-mode-2026
JWT_EXPIRATION=7d

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Local PostgreSQL (Docker Compose service 'postgres' or local host)
# When running on host: localhost:5432. When inside Docker Compose: postgres:5432
DATABASE_URL=postgresql://invoicer_user:invoicer_secret_password@localhost:5432/invoicer_db
DATABASE_SSL=false

# Discrete PostgreSQL Parameters (Used by Docker Compose / CLI tools)
POSTGRES_USER=invoicer_user
POSTGRES_PASSWORD=invoicer_secret_password
POSTGRES_DB=invoicer_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Option 2: Neon Cloud PostgreSQL (Serverless)
# Uncomment below for Neon Cloud deployment:
# DATABASE_URL=postgresql://[user]:[password]@[ep-branch-id].us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

# ------------------------------------------------------------------------------
# AI Service (Google Gemini API)
# ------------------------------------------------------------------------------
# Leave blank to use built-in intelligent rule & financial analysis heuristics,
# or provide your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen

# Storage / Uploads Destination
UPLOAD_DEST=./uploads
